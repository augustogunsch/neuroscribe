# The version of the Android app, and the only place it is written down.
#
# `make app-release` reads this, stamps it into the APK and names the file
# after it. Bump it here — 1.0.1, 1.2.0, whatever the change deserves — and
# nothing else needs editing.
#
# VERSION is what people see. CODE is the integer Android orders installs by:
# it must go up every release or the phone refuses the upgrade as a downgrade,
# and it is derived from VERSION rather than tracked by hand, so it cannot
# drift. 1.2.3 becomes 10203, which leaves room for 99 patches and 99 minors.

VERSION = 1.0.0

# Where the phone syncs to. Baked into the app at build time, because the app
# serves its own frontend and needs to know whose server the rest belongs to.
ORIGIN = https://neuroscribe.augustogunsch.com
