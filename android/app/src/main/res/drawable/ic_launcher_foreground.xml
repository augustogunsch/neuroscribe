<?xml version="1.0" encoding="utf-8"?>
<!-- The same graph tracing an N as static/logo.svg, redrawn as a vector
     drawable. The 64-unit artwork sits centred in the 108-unit adaptive icon
     canvas, which keeps it inside the 72-unit safe zone every launcher shape
     is guaranteed to show. Solid indigo rather than the web logo's gradient:
     at launcher size the gradient is invisible and the extra markup is not. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:translateX="22" android:translateY="22">
        <path
            android:pathData="M14,50 L14,14 L50,50 L50,14"
            android:strokeColor="#7c6cf0"
            android:strokeWidth="3.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M14,14 L32,32 M32,32 L50,14 M14,50 L32,32"
            android:strokeColor="#7c6cf0"
            android:strokeWidth="3.2"
            android:strokeAlpha="0.35"
            android:strokeLineCap="round" />

        <path
            android:pathData="M14,8 a6,6 0 1,0 0.1,0z M14,44 a6,6 0 1,0 0.1,0z M50,8 a6,6 0 1,0 0.1,0z M50,44 a6,6 0 1,0 0.1,0z"
            android:fillColor="#7c6cf0" />
        <path
            android:pathData="M32,27.5 a4.5,4.5 0 1,0 0.1,0z"
            android:fillColor="#7c6cf0" />
    </group>
</vector>
